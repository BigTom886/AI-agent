<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wc</groupId>
        <artifactId>wc-ai-agent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>wc-ai-agent-app</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            参数校验：用户注册/登录接口使用 @Valid + @NotBlank/@Size 校验请求体。
            hibernate-validator 本来就通过 web starter 传递进来了，
            这里显式声明，避免以后调整依赖时校验悄悄失效。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring AI OpenAI Starter（任何兼容 OpenAI 协议的服务商都能接） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
            RAG（检索增强生成）：Spring AI 1.0 起把向量库相关类从 spring-ai-core 拆成了独立模块，
            不显式引入的话 com.wc.rag 包会整片报红（org.springframework.ai.vectorstore 找不到）。
            版本统一由父 POM 的 spring-ai-bom (1.1.8) 管理，这里不要写 version。
        -->
        <!-- VectorStore / SearchRequest / Document 等向量库通用 API -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>
        <!-- PgVectorStore（PostgreSQL + pgvector 扩展）：知识库就存在这个向量库里 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pgvector-store</artifactId>
        </dependency>

        <!--
            对话记忆：框架自带 ChatMemory + MessageWindowChatMemory，
            以及 JDBC 版 ChatMemoryRepository（自动识别 PostgreSQL 方言并建表），
            项目里不再写任何记忆相关 Java 代码
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
        </dependency>

        <!--
            MyBatis-Plus：数据访问层。
            Mapper 继承 BaseMapper<T>，常规 CRUD 不用写 SQL，
            条件查询用 LambdaQueryWrapper，主键/列名由实体上的注解声明。
            它传递依赖 spring-boot-starter-jdbc，所以 JdbcTemplate 自动配置仍然可用。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.18</version>
        </dependency>

        <!-- JDBC：数据源（PostgreSQL）+ JdbcTemplate。
             显式保留是因为 Spring AI 的 JdbcChatMemoryRepository 需要 JdbcTemplate Bean
             （MyBatis starter 也会传递引入，这里写出来是为了说明依赖关系） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- PostgreSQL 驱动：对话记忆持久化（版本由 spring-boot-starter-parent 统一管理） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-generator</artifactId>
            <version>4.38.0</version>
        </dependency>

        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.19.1</version>
        </dependency>

        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itext-core</artifactId>
            <version>9.2.0</version>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>font-asian</artifactId>
            <version>9.2.0</version>
        </dependency>
        <!-- iText pdfHTML：把 HTML 渲染为 PDF（版本需与 itext-core 9.x 配套） -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>html2pdf</artifactId>
            <version>6.2.0</version>
        </dependency>
        <!-- flexmark：完整的 Markdown 解析器，把 Markdown 转成 HTML -->
        <dependency>
            <groupId>com.vladsch.flexmark</groupId>
            <artifactId>flexmark-all</artifactId>
            <version>0.64.8</version>
        </dependency>
        <!-- WebP 解码：iText 不支持 WebP 格式的网络图片，先转成 PNG 再嵌入 -->
        <dependency>
            <groupId>org.sejda.imageio</groupId>
            <artifactId>webp-imageio</artifactId>
            <version>0.1.6</version>
        </dependency>

        <!--
            MCP 客户端 —— 同步（SseHttpClientTransport）。
            不要同时引入 client-webflux：两个 starter 都会注册 List<NamedClientMcpTransport>，
            被 McpClientAutoConfiguration.mcpSyncClients 聚合，导致对同一个 URL 建立两条连接。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.37</version>
        </dependency>

        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>4.4.0</version>
        </dependency>

        <!-- 覆盖 knife4j 4.4.0 传递的 springdoc 2.3.0：
             springdoc 2.3.0 与 Spring Boot 3.4 (Spring Framework 6.2) 不兼容，
             生成 /v3/api-docs 时抛 NoSuchMethodError 导致 500 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.13</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.36</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>