# 本地开发密钥配置模板
# 用法：复制本文件为同目录 application-local.yml，填入你【轮换后的新 key】。
# application-local.yml 已被 .gitignore 忽略，不会提交。

spring:
  ai:
    openai:
      # 任何 OpenAI 兼容服务商都行：填你的 key，必要时再补 base-url / model
      api-key: 你的大模型API密钥
      # 必填：你的服务商地址（OpenAI 兼容模式）
      base-url: https://你的服务商/v1
      chat:
        options:
          # 必填：模型 id
          model: 你的模型名
      # RAG 的 embedding 模型（和聊天模型可以不是同一个服务商）：
      # 知识库是 text-embedding-v3（1024 维）向量化后存进 pgvector 的，
      # 提问时必须用同一个模型向量化，模型名要和当初灌库时一致
      embedding:
        api-key: 你的embedding模型密钥
        # base-url: https://dashscope.aliyuncs.com/compatible-mode
        # options:
        #   model: text-embedding-v3
  # —— 对话记忆数据库（PostgreSQL）——
  # 填你本地的 PostgreSQL 账号密码；库名默认 wc_ai_agent，首次启动会自动建表
  datasource:
    username: postgres
    password: 你的PostgreSQL密码

search-api:
  api-key: 你的新SearchAPI密钥
